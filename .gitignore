# dependencies
node_modules/
# Vega / React Native build output
apps/vega-player/build/
apps/vega-player/buildinfo.json
apps/vega-player/dist/
apps/vega-player/.vega/
# large third-party player build copied from the official sample (regenerate: see docs/architecture.md)
apps/vega-player/src/w3cmedia/shakaplayer/dist/*.map
# OS / editor
.DS_Store
*.log.tmp
# participant data must never be committed
docs/study/participants/
docs/study/raw/
# local media servers and scratch
.http-server/

# HLS renditions of the film excerpts are derived; regenerate with tools/hls/make-hls.sh <master.mp4>
assets/tos-*/hls/
# Vega Shaka glue from Amazon's vega-video-sample (regenerated by tools/shaka/fetch-glue.sh; not committed, see docs/licensing.md)
apps/vega-player/src/w3cmedia/PlayerInterface.ts
apps/vega-player/src/w3cmedia/polyfills/
apps/vega-player/src/w3cmedia/shakaplayer/ShakaPlayer.ts

# Python caches
__pycache__/
*.pyc

# local-only documents (specs and reviews kept out of the public tree)
private/

# authoring work folders (audio extracts, raw tool output); results worth keeping are copied into docs/
assets/*/.author/
